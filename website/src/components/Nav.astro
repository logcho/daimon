<header id="site-nav" class="fixed inset-x-0 top-0 z-30">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.svg" alt="Daimon" class="h-6 w-6 invert" />
      <span class="font-display text-base font-medium tracking-tight text-neutral-100">Daimon</span>
    </a>
    <nav class="font-display flex items-center gap-6 text-[15px] text-neutral-300">
      <a href="#how-it-works" class="hidden transition hover:text-neutral-100 sm:inline">How it works</a>
      <a href="#features" class="hidden transition hover:text-neutral-100 sm:inline">Features</a>
      <a
        href="https://github.com/logcho/daimon"
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm transition hover:border-white/25 hover:text-neutral-100"
      >
        GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const hero = document.getElementById("hero");
  const solidClasses = ["border-b", "border-white/5", "bg-[#050505]"];

  if (nav && hero) {
    const navHeight = nav.offsetHeight;
    const observer = new IntersectionObserver(
      ([entry]) => {
        for (const cls of solidClasses) {
          nav.classList.toggle(cls, !entry.isIntersecting);
        }
      },
      { rootMargin: `-${navHeight}px 0px 0px 0px`, threshold: 0 },
    );
    observer.observe(hero);
  }
</script>
