<header id="site-nav" class="fixed inset-x-0 top-0 z-30">
  <div
    id="site-nav-bg"
    class="pointer-events-none absolute inset-0 -z-10 border-b border-white/10 bg-[#0b0b0f] transition-[clip-path] duration-500 ease-out [clip-path:inset(0_0_100%_0)]"
  >
  </div>
  <div class="relative mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.svg" alt="Daimon" class="h-6 w-6 invert" />
      <span class="font-display text-base font-medium tracking-tight text-neutral-100">Daimon</span>
    </a>
    <nav class="font-display flex items-center gap-6 text-[15px] text-neutral-300">
      <a href="#how-it-works" class="transition hover:text-neutral-100">How it works</a>
      <a href="#features" class="transition hover:text-neutral-100">Features</a>
    </nav>
  </div>
</header>

<script>
  const navBg = document.getElementById("site-nav-bg");
  const HIDDEN = "[clip-path:inset(0_0_100%_0)]";
  const VISIBLE = "[clip-path:inset(0_0_0%_0)]";

  if (navBg) {
    const syncNav = () => {
      const scrolled = window.scrollY > 40;
      navBg.classList.toggle(HIDDEN, !scrolled);
      navBg.classList.toggle(VISIBLE, scrolled);
    };
    syncNav();
    window.addEventListener("scroll", syncNav, { passive: true });
  }
</script>
