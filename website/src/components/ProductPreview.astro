---
import HeroMockup from "./HeroMockup.astro";
---

<section class="flex h-screen flex-col items-center justify-center px-6 py-10">
  <div data-reveal class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <span class="mb-4 font-mono text-xs font-medium tracking-[0.25em] text-[#4f8dff] uppercase">Live status</span>
    <h2 class="font-display text-3xl font-medium tracking-tight text-neutral-50 sm:text-4xl">
      Watch it work, if you want to.
    </h2>
    <p class="mt-4 max-w-lg text-neutral-400">
      Every step streams to the pill in real time — or ignore it entirely until it's done.
    </p>
    <div class="mt-10 w-full max-w-sm">
      <HeroMockup />
    </div>
  </div>
</section>
