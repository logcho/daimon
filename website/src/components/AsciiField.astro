---
// A static, build-time-generated field of monospace glyphs behind the hero
// — an original ambient texture (not any specific illustration). Faded
// only top/bottom so it's actually visible across the full width, not
// concentrated behind the centered text column where it'd be hidden.
const COLS = 90;
const ROWS = 26;
const CHARS = ["·", "+", "×", "✦", "∙", "░", " ", " ", " ", " "];

function buildGrid() {
  let out = "";
  for (let row = 0; row < ROWS; row++) {
    let line = "";
    for (let col = 0; col < COLS; col++) {
      line += CHARS[Math.floor(Math.random() * CHARS.length)];
    }
    out += line + "\n";
  }
  return out;
}

const grid = buildGrid();
---

<pre
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 -z-20 overflow-hidden whitespace-pre text-center font-mono text-[12px] leading-[17px] text-[#4f8dff]/35 select-none [mask-image:linear-gradient(to_bottom,transparent,black_15%,black_85%,transparent)]"
>{grid}</pre>
