---
import Halftone from "./Halftone.astro";
---

<section class="relative isolate flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-28">
  <Halftone class="opacity-35" />
  <div data-reveal class="relative mx-auto max-w-2xl text-center">
    <p class="font-display text-2xl leading-snug font-medium text-neutral-100 italic sm:text-3xl">
      "Ambient intelligence: invisible when not needed, instantaneous when summoned."
    </p>
    <p class="mt-4 font-mono text-sm tracking-wide text-neutral-500 uppercase">— Daimon's design philosophy</p>
  </div>
</section>
