---
import { Image } from "astro:assets";
import mascot from "../assets/mascot.png";
import HeroMockup from "./HeroMockup.astro";
import AsciiField from "./AsciiField.astro";
---

<section class="relative overflow-hidden px-6 pt-20 pb-24 sm:pt-28 sm:pb-32">
  <AsciiField />
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_55%_at_50%_5%,rgba(79,141,255,0.2),transparent)]"
  >
  </div>

  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <div class="relative mb-6">
      <div
        class="pointer-events-none absolute inset-0 -z-10 scale-150 rounded-full bg-[#4f8dff]/20 blur-3xl"
      >
      </div>
      <Image src={mascot} alt="Daimon" width={220} height={220} class="h-40 w-40 sm:h-52 sm:w-52" />
    </div>

    <span class="mb-5 text-xs font-medium tracking-[0.25em] text-[#4f8dff] uppercase">
      Ambient · Local-First · In Active Development
    </span>

    <h1
      class="text-glow text-5xl leading-[1.05] font-semibold tracking-tight text-neutral-50 sm:text-6xl lg:text-7xl"
    >
      An agent that runs<br /> in the background, <span class="text-[#4f8dff]">not your way</span>.
    </h1>

    <p class="mt-6 max-w-xl text-lg text-neutral-400">
      Every computer runs daemons quietly in the background — Daimon is one that works for you.
      No separate desktop, no takeover, just an extra set of hands while you keep working.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://github.com/logcho/daimon"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-neutral-100 transition hover:border-white/25 hover:bg-white/10"
      >
        View on GitHub
      </a>
      <a
        href="#how-it-works"
        class="rounded-full px-5 py-2.5 text-sm font-medium text-neutral-400 transition hover:text-neutral-100"
      >
        See how it works ↓
      </a>
    </div>

    <div class="mt-16 w-full max-w-sm">
      <HeroMockup />
    </div>
  </div>
</section>
