---
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import AsciiField from "./AsciiField.astro";
import RayBurst from "./RayBurst.astro";
---

<section id="hero" class="relative isolate flex h-screen flex-col justify-center overflow-hidden px-6 py-10">
  <AsciiField />
  <RayBurst />
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_55%_at_50%_5%,rgba(79,141,255,0.2),transparent)]"
  >
  </div>

  <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
    <div class="relative mb-5">
      <div
        class="pointer-events-none absolute inset-0 -z-10 scale-150 rounded-full bg-[#4f8dff]/20 blur-3xl"
      >
      </div>
      <Image src={logo} alt="Daimon" width={260} height={260} class="h-48 w-48 invert sm:h-64 sm:w-64" />
    </div>

    <span class="mb-4 font-mono text-xs font-medium tracking-[0.25em] text-[#4f8dff] uppercase">
      Ambient · Local-First · In Active Development
    </span>

    <h1
      class="font-display text-glow text-4xl leading-[1.05] font-medium tracking-tight text-neutral-50 sm:text-5xl lg:text-6xl"
    >
      An agent that runs<br /> in the background, <span class="text-[#4f8dff] italic">not in your way</span>.
    </h1>

    <p class="mt-5 max-w-xl text-base text-neutral-400 sm:text-lg">
      Every computer runs daemons quietly in the background — Daimon is one that works for you.
      No separate desktop, no takeover, just an extra set of hands while you keep working.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://github.com/logcho/daimon"
        target="_blank"
        rel="noreferrer"
        class="rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-neutral-100 transition hover:border-white/25 hover:bg-white/10"
      >
        View on GitHub
      </a>
      <a
        href="#how-it-works"
        class="rounded-full px-5 py-2.5 text-sm font-medium text-neutral-400 transition hover:text-neutral-100"
      >
        See how it works ↓
      </a>
    </div>
  </div>
</section>
