---
const steps = [
  {
    title: "Tell it what to do",
    body: "Type an instruction into the pill — a small widget that lives quietly in the corner of your screen.",
  },
  {
    title: "It works in the background",
    body: "Daimon runs the task inside its own invisible workspace — browsing, filling forms, running commands — without touching your mouse, keyboard, or foreground apps.",
  },
  {
    title: "You keep working",
    body: "No context switch, no handing over your machine. Watch live status if you want to, or ignore it entirely until it's done.",
  },
  {
    title: "It remembers",
    body: "Completed tasks and learned skills persist, so the next similar request starts from what it already knows.",
  },
];
---

<section id="how-it-works" class="px-6 py-28">
  <div data-reveal class="mx-auto max-w-5xl">
    <div class="text-center">
      <span class="text-xs font-medium tracking-[0.25em] text-[#4f8dff] uppercase">Process</span>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-neutral-50 sm:text-4xl">
        Give it a task. Keep working.
      </h2>
    </div>

    <div class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      <div
        class="pointer-events-none absolute top-6 right-[12%] left-[12%] hidden h-px bg-gradient-to-r from-transparent via-white/15 to-transparent lg:block"
      >
      </div>

      {
        steps.map((step, i) => (
          <div class="relative flex flex-col items-start">
            <span class="relative z-10 mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-[#4f8dff]/30 bg-[#0a0a0a] text-base font-medium text-[#4f8dff]">
              {i + 1}
            </span>
            <h3 class="text-lg font-medium text-neutral-100">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-400">{step.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
