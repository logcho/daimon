---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 px-6 py-10">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-3 text-center text-xs text-neutral-600 sm:flex-row sm:justify-between sm:text-left"
  >
    <span>© {year} Daimon</span>
    <a
      href="https://github.com/logcho/daimon"
      target="_blank"
      rel="noreferrer"
      class="transition hover:text-neutral-300"
    >
      GitHub
    </a>
    <span>Built with Tauri, LangGraph, and Claude.</span>
  </div>
</footer>
