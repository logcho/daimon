{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["pill"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-show",
    "core:window:allow-set-resizable",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-start-dragging",
    "opener:default",
    "global-shortcut:default",
    "shell:allow-execute",
    "allow-start-session",
    "allow-send-message",
    "allow-end-session",
    "allow-get-api-key-status",
    "allow-set-api-key",
    "allow-get-google-client-id-status",
    "allow-set-google-client-id",
    "allow-connect-gmail-account",
    "allow-get-gmail-account",
    "allow-disconnect-gmail-account",
    "allow-get-vault-path-status",
    "allow-set-vault-path",
    "allow-list-vault-files",
    "allow-read-vault-file",
    "allow-list-automations",
    "allow-create-automation",
    "allow-set-automation-enabled",
    "allow-delete-automation",
    "allow-get-voice-model-status",
    "allow-download-voice-model",
    "allow-toggle-dictation",
    "allow-get-chromium-status",
    "allow-download-chromium",
    "allow-start-terminal",
    "allow-write-to-terminal",
    "allow-resize-terminal",
    "allow-close-terminal",
    "allow-get-claude-cli-status",
    "allow-list-recordings",
    "allow-read-recording-file",
    "allow-get-accessibility-trust-status",
    "allow-activate-and-focus-window",
    "allow-set-window-vibrancy"
  ]
}
