# Daimon agent harness configuration. Copy to .env and fill in.

# --- Models ------------------------------------------------------------------
# Either role may be a bare model name (resolved against DAIMON_PROVIDER) or an
# explicit `provider:model` spec. That is how you run the main agent on a
# stronger model while sub-agents and summarization stay cheap:
#   DAIMON_MODEL=anthropic:claude-sonnet-5
#   DAIMON_FLASH_MODEL=deepseek-chat
# The anthropic provider is an optional extra: `uv sync --extra anthropic`.
DAIMON_PROVIDER=deepseek

# Main agent role (chat session, debugging, feature implementation).
DAIMON_MODEL=deepseek-chat
# Cheap helper role (subagents, file ops, search, summarization).
# Defaults to DAIMON_MODEL if unset.
DAIMON_FLASH_MODEL=
DEEPSEEK_API_KEY=
# Optional override; falls through to DEEPSEEK_API_BASE, then the SDK default.
DAIMON_API_BASE=

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=

# Cost reporting. Prices are built in per model; this overrides or adds one
# without waiting on a release. JSON of {"model": [input, output, cache_read,
# cache_write]} in $ per million tokens. An unpriced model reports tokens only.
DAIMON_PRICES=

# --- Workspace / data dirs ---------------------------------------------------
DAIMON_VAULT_DIR=./vault
# Defaults to DAIMON_VAULT_DIR. The agent's shell/file tools are confined here.
DAIMON_WORKSPACE_DIR=
DAIMON_MEMORY_DB=./memory/daimon.db
DAIMON_CHECKPOINTS_DB=./memory/checkpoints.db
DAIMON_SKILLS_DIR=

# --- PinchTab (browser sidecar) ----------------------------------------------
# Managed by scripts/setup-pinchtab.sh, which writes .daimon/pinchtab.env.
PINCHTAB_BASE=http://127.0.0.1:9867
PINCHTAB_TOKEN=
PINCHTAB_BIN=
DAIMON_CHROME_BIN=

# --- Server ------------------------------------------------------------------
PORT=4711
DAIMON_LIVE_FRAMES=1
# Post-turn reflection on tool-using turns (writes reusable procedures to
# memory).
DAIMON_REFLECT=1
# Main-agent compaction threshold, in real tokens taken from the last model
# call's reported usage. The flash model produces the summary, and the result
# is written back to state so a long turn summarizes once, not once per hop.
DAIMON_COMPACTION_TOKENS=60000
# Cold-start estimate only — used before any call has reported usage.
DAIMON_COMPACTION_CHARS=40000
# Denominator for the "ctx N%" indicator. Not a hard limit; the provider
# enforces the real one.
DAIMON_CONTEXT_WINDOW=128000

# --- Search ------------------------------------------------------------------
# Optional escape hatch if DuckDuckGo scraping is flaky.
TAVILY_API_KEY=
