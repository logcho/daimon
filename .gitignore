# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — see .env.example
.env

# Local persistent memory/skills DB — bind-mounted into the workspace
# container, not source (see workspace.rs)
/memory/

# Daimon-managed default notes vault (falls back to this when no Obsidian
# vault path is configured) — bind-mounted into the workspace container,
# not source (see vault.rs)
/vault/

# Cron automations store + pending-request mount (bind-mounted into the
# workspace container, not source — see automation.rs)
/automations.json
/automations/

# Downloaded local whisper.cpp model(s) for on-device dictation — a large
# binary artifact fetched on demand from Settings, not source (see voice.rs)
/whisper-models/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
