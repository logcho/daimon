{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the pill widget window",
  "windows": ["pill"],
  "permissions": [
    "core:default",
    "allow-agent-status",
    "allow-start-chat",
    "allow-send-message",
    "allow-get-config",
    "allow-update-config",
    "allow-close-agent",
    "allow-set-window-vibrancy",
    "allow-activate-and-focus-window",
    "allow-start-terminal",
    "allow-write-to-terminal",
    "allow-resize-terminal",
    "allow-close-terminal",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-focus",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-show",
    "core:window:allow-set-resizable",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-visible-on-all-workspaces",
    "core:window:allow-start-dragging",
    "allow-voice-model-status",
    "allow-download-voice-model",
    "allow-start-dictation",
    "allow-stop-dictation",
    "allow-accessibility-trusted",
    "allow-get-vault-path-status",
    "allow-set-vault-path",
    "allow-list-vault-files",
    "allow-read-vault-file",
    "allow-list-skills",
    "allow-read-skill",
    "allow-list-models",
    "allow-delete-skill",
    "allow-list-notes",
    "allow-read-note",
    "allow-delete-note"
  ]
}
